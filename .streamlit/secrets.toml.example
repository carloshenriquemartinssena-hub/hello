# Cole em Streamlit Cloud > app hello > Settings > Secrets.
# Formato TOML: cada valor deve ficar entre aspas. Não use [secrets].
# Use somente o banco e as credenciais do CRM 2.
CRM_ENV = "production"
# Para não pedir senha no painel: false. Nesse caso, mantenha o app privado no Streamlit.
# As chaves internas abaixo continuam necessárias, mesmo sem a tela de login.
CRM_REQUIRE_LOGIN = true
CRM_DATABASE_URL = "postgresql+psycopg://USUARIO:SENHA@HOST:5432/postgres?sslmode=verify-full&sslrootcert=system"
# Se aparecer DB_CERTIFICATE: veja CERTIFICADO_SUPABASE.md e cole o PEM oficial aqui.
CRM_DATABASE_CA_CERT = ""
CRM_ADMIN_PASSWORD = "SUBSTITUA_PELA_SUA_SENHA_FORTE"
CRM_SESSION_SECRET = "SUBSTITUA_PELO_VALOR_JA_GERADO_NO_SEU_ENV"
CRM_WORKER_TOKEN = "SUBSTITUA_PELO_VALOR_JA_GERADO_NO_SEU_ENV"
CRM_APIFY_TOKEN = "SUBSTITUA_PELO_SEU_TOKEN_APIFY"
CRM_GMAIL_CLIENT_ID = "SUBSTITUA_PELO_SEU_CLIENT_ID"
CRM_GMAIL_CLIENT_SECRET = "SUBSTITUA_PELO_SEU_CLIENT_SECRET"
CRM_GMAIL_REFRESH_TOKEN = "SUBSTITUA_PELO_SEU_REFRESH_TOKEN"
# Opcional para o painel Streamlit. Não use a URL do GitHub Pages.
CRM_PUBLIC_URL = ""
