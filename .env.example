# Configuração privada: copie para .env na mesma pasta de iniciar.py.
# O CRM lê .env automaticamente. Nunca envie esse arquivo ao GitHub.

# BANCO: substitua pelo PostgreSQL do Supabase > Connect > Session pooler.
# Exemplo: postgresql+psycopg://postgres.PROJETO:SENHA@HOST:5432/postgres?sslmode=verify-full
# Não use a chave anon. Codifique caracteres especiais da senha na URI.
CRM_DATABASE_URL=sqlite:///data/crm2.db

# CAPTAÇÃO: token da sua conta Apify.
CRM_APIFY_TOKEN=

# EMAIL: credenciais OAuth da conta Gmail remetente.
CRM_GMAIL_CLIENT_ID=
CRM_GMAIL_CLIENT_SECRET=
CRM_GMAIL_REFRESH_TOKEN=

# ACESSO: python iniciar.py --gerar-acesso preenche somente os campos vazios.
CRM_ADMIN_PASSWORD=
CRM_SESSION_SECRET=
CRM_WORKER_TOKEN=

# Local: development. Em Secrets do Streamlit: CRM_ENV = "production".
# CRM_PUBLIC_URL pode ficar vazio no Streamlit.
# Streamlit privado: false dispensa digitar senha; mantenha o app privado na plataforma.
CRM_REQUIRE_LOGIN=true
CRM_ENV=development
CRM_PUBLIC_URL=
