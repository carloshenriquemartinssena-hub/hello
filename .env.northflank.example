# MODELO SEM CREDENCIAIS. Importe os seus valores no painel da hospedagem.
# Não sobrescreva um .env que você já preencheu com este modelo vazio.
CRM_ENV=production
PORT=10000

# URI PostgreSQL em Supabase > Connect > Session pooler, nunca a URL https da API.
# Acrescente sslmode=verify-full e configure o certificado raiz oficial se necessário.
CRM_DATABASE_URL=

# URL HTTPS pública do serviço, sem barra final. Não use GitHub Pages.
CRM_PUBLIC_URL=

CRM_APIFY_TOKEN=
CRM_GMAIL_CLIENT_ID=
CRM_GMAIL_CLIENT_SECRET=
CRM_GMAIL_REFRESH_TOKEN=

# Reutilize os valores fortes que já foram gerados no seu .env local.
CRM_ADMIN_PASSWORD=
CRM_SESSION_SECRET=
CRM_WORKER_TOKEN=
